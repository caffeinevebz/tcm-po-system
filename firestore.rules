rules_version = '2';

// =============================================================================
// TCM BrewOps — Firestore security rules
// -----------------------------------------------------------------------------
// This is the real security boundary. The checks inside the pages are only there
// to keep the UI honest; a determined visitor can bypass those, but not these.
//
// Roles come from the `role` custom claim, written by the Cloud Functions in
// functions/index.js after a verified phone sign-in:
//
//   owner   one person, the number configured as OWNER_PHONE. Full access.
//   staff   invite-only: the owner adds the mobile number first, then that
//           person registers with an SMS code. May raise material requests,
//           add recipes, and book in deliveries.
//   (none)  any number that was never invited, or has been removed — treated
//           exactly like a stranger.
//
// Publish with:  firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- role helpers -------------------------------------------------------
    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }
    function isOwner()  { return role() == 'owner'; }
    function isStaff()  { return role() == 'staff'; }
    function signedIn() { return isOwner() || isStaff(); }

    // Keys this write is adding, removing or changing. Only valid inside an
    // `allow update` rule, where `resource` is the stored document.
    //
    // Note: Firestore evaluates rules twice — once optimistically before the
    // document is fetched, then again with real data. diff() raises an
    // "evaluation error" in that first pass, which shows up in emulator and
    // console logs even though the write is decided correctly by the second
    // pass. This is expected for any diff()-based rule, not a misconfiguration.
    function touched() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- team directory -----------------------------------------------------
    // One document per invited mobile number, keyed by its last 10 digits.
    //
    // Written ONLY by the Cloud Functions through the Admin SDK, which bypasses
    // these rules. No client may write here — otherwise a staff member could
    // invite themselves, or flip their own status back to "active" after being
    // removed.
    match /staffMembers/{phoneKey} {
      allow read: if isOwner()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // --- PIN hashes and login throttling ------------------------------------
    // Never readable or writable by any client, at all.
    match /_staffSecrets/{document=**} { allow read, write: if false; }
    match /_authThrottle/{document=**} { allow read, write: if false; }

    // --- shared settings document ------------------------------------------
    // Catalogue, vendors, master prices, prep rules, PO counter, scanner aliases.
    match /settings/main {
      allow read: if signedIn();

      allow create, update: if isOwner();

      // Staff need exactly one thing here: to teach the scanner that an invoice
      // line maps to a catalogue item. Nothing else is writable by them — in
      // particular not `prices`.
      allow update: if isStaff() && touched().hasOnly(['aliases']);

      allow delete: if false;
    }

    // --- staff material requests -------------------------------------------
    match /requests/{requestId} {
      function validRequest(d) {
        return d.keys().hasAll(['id', 'items'])
            && d.id is string
            && d.items is list
            && d.items.size() > 0
            && d.items.size() <= 200;
      }

      allow read:   if signedIn();
      allow create: if signedIn() && validRequest(request.resource.data);

      // The owner triages requests into POs. Staff cannot rewrite or withdraw a
      // request once it is submitted.
      allow update, delete: if isOwner();
    }

    // --- purchase orders ----------------------------------------------------
    match /pos/{poId} {
      allow read:   if signedIn();

      // Raising and cancelling POs is the owner's decision alone.
      allow create: if isOwner();
      allow delete: if isOwner();
      allow update: if isOwner();

      // Staff may only book in a delivery against an already-approved PO: mark
      // it Delivered and record what actually arrived. They cannot reopen a PO,
      // change the ordered lines, or reassign the supplier.
      allow update: if isStaff()
                    && touched().hasOnly(['status', 'receivedItems', 'deliveryDate', 'receivedBy'])
                    && request.resource.data.status == 'Delivered'
                    && resource.data.status == 'Approved'
                    && request.resource.data.receivedItems is list;
    }

    // --- recipe book --------------------------------------------------------
    match /recipes/{recipeId} {
      function validNewRecipe(d) {
        return d.keys().hasAll(['id', 'name', 'ingredients'])
            && d.name is string
            && d.name.size() > 0
            && d.name.size() <= 120
            && d.ingredients is list
            && d.ingredients.size() <= 200;
      }

      allow read: if signedIn();

      // Staff may ADD a recipe, and it must be stamped with their own uid so
      // there is a record of who wrote it. They may not edit or delete any
      // recipe afterwards — including their own — so the book cannot be
      // rewritten without the owner.
      allow create: if isOwner()
                    || (isStaff()
                        && validNewRecipe(request.resource.data)
                        && request.resource.data.createdBy == request.auth.uid);

      allow update, delete: if isOwner();
    }

    // --- default deny -------------------------------------------------------
    // Anything not named above is closed, including collections added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
