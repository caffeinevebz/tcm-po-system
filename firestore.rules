rules_version = '2';

// =============================================================================
// TCM BrewOps — Firestore security rules
// -----------------------------------------------------------------------------
// This is the real security boundary. The checks inside the pages only keep the
// UI honest; a determined visitor can bypass those, but not these.
//
//   owner   one account, the address configured as OWNER_EMAIL. Everything.
//   user    an account the owner created. May do exactly what the owner ticked
//           on their user document, and nothing else.
//   nobody  anyone else, including a signed-in account that has been suspended.
//
// Permissions are read from /users/{username} on every request rather than from
// a token claim. That costs one document read, and buys immediate effect: when
// the owner unticks a box or suspends someone, the very next write is refused —
// no waiting for a cached token to expire.
//
// Publish with:  firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- who is asking ------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.token.get('role', '') == 'owner';
    }

    // The caller's account document. Users are keyed by username, so this finds
    // it through the uid index maintained by the Cloud Functions.
    function account() {
      return get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return signedIn()
             && request.auth.token.get('role', '') == 'user'
             && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
             && account().status == 'active';
    }

    /** Owner can do anything; a user needs the specific box ticked. */
    function can(permission) {
      return isOwner() || (isActiveUser() && account().perms[permission] == true);
    }

    /** Signed in as somebody the app recognises. */
    function member() {
      return isOwner() || isActiveUser();
    }

    // Keys this write is adding, removing or changing. Only valid in an update
    // rule, where `resource` is the stored document.
    //
    // Firestore evaluates rules twice — once optimistically before the document
    // is fetched, then again with real data. diff() raises an "evaluation error"
    // in the first pass, which appears in console logs even though the write is
    // decided correctly by the second. Expected for any diff()-based rule.
    function touched() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- accounts -----------------------------------------------------------
    // Written ONLY by the Cloud Functions through the Admin SDK, which bypasses
    // these rules. If a client could write here, a user could tick their own
    // permission boxes or un-suspend themselves.
    match /users/{username} {
      allow read: if isOwner()
                  || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // A uid -> account mirror so the rules above can look someone up by uid
    // without a query. Same rule: functions only.
    match /userIndex/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // --- access-key hashes and sign-in throttling ---------------------------
    // Never readable or writable by any client, at all.
    match /_userSecrets/{document=**} { allow read, write: if false; }
    match /_authThrottle/{document=**} { allow read, write: if false; }

    // --- shared settings ----------------------------------------------------
    // Catalogue, vendors, master prices, prep rules, PO counter, scanner aliases.
    // These live in one document, so writes are gated per field group.
    match /settings/main {
      // Cost prices live here, so reading requires either the prices permission
      // or one of the permissions that genuinely needs the catalogue.
      allow read: if member();

      allow create: if isOwner();

      allow update: if isOwner()
                    || (can('inventory') && touched().hasOnly(['inventory', 'prepItems', 'poCounter']))
                    || (can('prices')    && touched().hasOnly(['prices']))
                    || (can('vendors')   && touched().hasOnly(['suppliers', 'ownerPhone']))
                    // Teaching the invoice scanner a name mapping is part of
                    // booking in a delivery.
                    || (can('receive')   && touched().hasOnly(['aliases']));

      allow delete: if false;
    }

    // --- material requests --------------------------------------------------
    match /requests/{requestId} {
      function validRequest(d) {
        return d.keys().hasAll(['id', 'items'])
            && d.id is string
            && d.items is list
            && d.items.size() > 0
            && d.items.size() <= 200;
      }

      allow read:   if member();
      allow create: if can('requests') && validRequest(request.resource.data);

      // Turning requests into purchase orders is a purchasing decision.
      allow update, delete: if can('poManage');
    }

    // --- purchase orders ----------------------------------------------------
    match /pos/{poId} {
      allow read: if member();

      allow create: if can('poManage');
      allow delete: if can('poManage');
      allow update: if can('poManage');

      // Booking in a delivery is a separate, much narrower permission: mark an
      // approved order Delivered and record what actually arrived. It cannot
      // reopen an order, change the ordered lines, or reassign the supplier.
      allow update: if can('receive')
                    && touched().hasOnly(['status', 'receivedItems', 'deliveryDate', 'receivedBy'])
                    && request.resource.data.status == 'Delivered'
                    && resource.data.status == 'Approved'
                    && request.resource.data.receivedItems is list;
    }

    // --- recipe book --------------------------------------------------------
    match /recipes/{recipeId} {
      function validNewRecipe(d) {
        return d.keys().hasAll(['id', 'name', 'ingredients'])
            && d.name is string
            && d.name.size() > 0
            && d.name.size() <= 120
            && d.ingredients is list
            && d.ingredients.size() <= 200;
      }

      allow read: if can('recipesView');

      // Adding is separate from editing, and a new recipe must carry the uid of
      // whoever wrote it.
      allow create: if isOwner()
                    || (can('recipesAdd')
                        && validNewRecipe(request.resource.data)
                        && request.resource.data.createdBy == request.auth.uid);

      allow update, delete: if can('recipesEdit');
    }

    // --- default deny -------------------------------------------------------
    // Anything not named above is closed, including collections added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
